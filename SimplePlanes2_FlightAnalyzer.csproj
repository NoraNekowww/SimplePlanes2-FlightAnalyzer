<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LandingRateMonitor</AssemblyName>
    <RootNamespace>SimplePlanes2.LandingRate</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\SimplePlanes 2</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx Core Reference -->
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Game Core -->
    <Reference Include="Game">
      <HintPath>$(GameDir)\SimplePlanes 2_Data\Managed\Game.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity Engine Modules -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\SimplePlanes 2_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\SimplePlanes 2_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\SimplePlanes 2_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\SimplePlanes 2_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\SimplePlanes 2_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\SimplePlanes 2_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
